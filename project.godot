; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Last Bell: 14.A"
config/description="Choice-based comedy visual novel - Magyar technikumi szimulátor"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.039, 0.055, 0.078, 1)
config/icon="res://assets/icon.svg"

[autoload]

GameManager="*res://scripts/GameManager.gd"
EventData="*res://scripts/EventData.gd"
DialogueManager="*res://scripts/DialogueManager.gd"
SaveManager="*res://scripts/SaveManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.039, 0.055, 0.078, 1)
